      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"booking-tour-app\"}[1m])) by (method, route, status_code)",
