          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"booking-tour-app\"}[1m])) by (le, route))",
          "legendFormat": "{{route}} (p95)",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Duration (p95)",
      "type": "timeseries"
