# ═══════════════════════════════════════
# TourViet — Environment Variables
# Copy this file to .env and fill values
# NEVER commit .env to GitHub!
# ═══════════════════════════════════════

# ── Database ────────────────────────────
DB_NAME=booking_tour
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME_strong_admin_pass_2024!
DB_APP_USER=tourapp
DB_APP_PASSWORD=CHANGE_ME_app_pass_2024!

# ── pgAdmin ─────────────────────────────
PGADMIN_EMAIL=admin@tourviet.local
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_pass_2024!

# ── Application ──────────────────────────
SESSION_SECRET=CHANGE_ME_random_secret_at_least_32_chars_here

# ── Grafana ─────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_pass_2024!
