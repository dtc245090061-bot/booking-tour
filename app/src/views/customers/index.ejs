<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="page-header">
    <div class="container">
      <h1 class="page-title">Quản Lý Khách Hàng</h1>
      <p class="page-subtitle"><%= customers.length %> khách hàng đã đăng ký</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <% if (customers.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">👥</div>
          <h3>Chưa có khách hàng nào</h3>
          <p>Khách hàng sẽ được thêm tự động khi có đặt tour</p>
        </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="data-table" id="customersTable">
          <thead>
            <tr>
              <th>ID</th>
              <th>Họ và Tên</th>
              <th>Email</th>
              <th>Điện Thoại</th>
              <th>Số Đặt Tour</th>
              <th>Tổng Chi Tiêu</th>
              <th>Ngày Đăng Ký</th>
            </tr>
          </thead>
          <tbody>
            <% customers.forEach(c => { %>
            <tr>
              <td><strong>#<%= c.id %></strong></td>
              <td>
                <div class="customer-name"><%= c.full_name %></div>
              </td>
              <td><%= c.email %></td>
              <td><%= c.phone %></td>
              <td>
                <span class="badge badge-primary"><%= c.booking_count %> tour</span>
              </td>
              <td><strong><%= parseInt(c.total_spent).toLocaleString('vi-VN') %> ₫</strong></td>
              <td><%= new Date(c.created_at).toLocaleDateString('vi-VN') %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
