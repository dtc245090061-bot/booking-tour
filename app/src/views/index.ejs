<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="TourViet - Khám phá vẻ đẹp Việt Nam, đặt tour du lịch dễ dàng và nhanh chóng" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content container">
      <div class="hero-badge">🌟 Hơn 50+ Tour Hấp Dẫn</div>
      <h1 class="hero-title">Khám Phá Việt Nam<br/><span class="gradient-text">Cùng TourViet</span></h1>
      <p class="hero-subtitle">Trải nghiệm những hành trình tuyệt vời, những vùng đất kỳ diệu và nền văn hóa đặc sắc của đất nước hình chữ S</p>
      <div class="hero-actions">
        <a href="/tours" class="btn btn-primary btn-lg">Xem Tất Cả Tour</a>
        <a href="/bookings/new" class="btn btn-outline btn-lg">Đặt Tour Ngay</a>
      </div>
      <!-- Search bar -->
      <div class="search-box">
        <form action="/tours" method="GET" class="search-form">
          <input type="text" name="destination" placeholder="🔍 Tìm điểm đến (Hà Nội, Đà Nẵng, Phú Quốc...)" class="search-input" />
          <button type="submit" class="btn btn-primary">Tìm Kiếm</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container stats-grid">
      <div class="stat-card">
        <div class="stat-number"><%= stats.total_tours || 0 %>+</div>
        <div class="stat-label">Tour Hấp Dẫn</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.total_bookings || 0 %>+</div>
        <div class="stat-label">Lượt Đặt Tour</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.total_customers || 0 %>+</div>
        <div class="stat-label">Khách Hàng Hài Lòng</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">63</div>
        <div class="stat-label">Tỉnh Thành</div>
      </div>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Tour Nổi Bật</h2>
        <p class="section-subtitle">Những hành trình được yêu thích nhất</p>
      </div>
      <% if (tours.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🗺️</div>
          <p>Chưa có tour nào. Hệ thống đang khởi tạo dữ liệu...</p>
        </div>
      <% } else { %>
      <div class="tours-grid">
        <% tours.forEach(tour => { %>
        <div class="tour-card">
          <div class="tour-img-wrap">
            <img src="<%= tour.image_url || '/css/placeholder.jpg' %>" alt="<%= tour.name %>" class="tour-img" onerror="this.src='/css/placeholder.jpg'" />
            <div class="tour-badge"><%= tour.duration %> ngày</div>
          </div>
          <div class="tour-body">
            <div class="tour-destination">📍 <%= tour.destination %></div>
            <h3 class="tour-name"><%= tour.name %></h3>
            <p class="tour-desc"><%= tour.description ? tour.description.substring(0, 100) + '...' : '' %></p>
            <div class="tour-footer">
              <div class="tour-price">
                <span class="price-label">Từ</span>
                <span class="price-value"><%= parseInt(tour.price).toLocaleString('vi-VN') %> ₫</span>
              </div>
              <a href="/tours/<%= tour.id %>" class="btn btn-primary btn-sm">Xem Chi Tiết</a>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <div class="section-footer">
        <a href="/tours" class="btn btn-outline btn-lg">Xem Tất Cả Tour →</a>
      </div>
      <% } %>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Tại Sao Chọn TourViet?</h2>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🛡️</div>
          <h3>An Toàn & Đảm Bảo</h3>
          <p>Đội ngũ hướng dẫn viên chuyên nghiệp, phương tiện đạt chuẩn an toàn</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💰</div>
          <h3>Giá Tốt Nhất</h3>
          <p>Cam kết hoàn tiền nếu bạn tìm được giá tốt hơn cho cùng chất lượng dịch vụ</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📱</div>
          <h3>Đặt Tour Dễ Dàng</h3>
          <p>Đặt tour online chỉ trong vài bước đơn giản, xác nhận tức thì</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🌟</div>
          <h3>Trải Nghiệm Tuyệt Vời</h3>
          <p>Hơn 10 năm kinh nghiệm, mang đến những kỷ niệm đáng nhớ</p>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
