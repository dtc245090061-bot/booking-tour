<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="page-header header-tour-detail" style="--tour-header-bg: url('<%= tour.image_url || "/images/vietnam-page-header.jpg" %>');">
    <div class="container">
      <div class="breadcrumb-group" style="display:flex;gap:0.6rem;margin-bottom:0.85rem;flex-wrap:wrap;align-items:center;">
        <a href="/" class="breadcrumb" title="Quay lại trang ban đầu">
          <svg class="breadcrumb-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Trang chủ</span>
        </a>
        <a href="/tours" class="breadcrumb" title="Quay lại danh sách tour">
          <svg class="breadcrumb-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Danh sách tour</span>
        </a>
      </div>
      <h1 class="page-title"><%= tour.name %></h1>
      <div class="tour-meta-header">
        <span class="badge badge-primary">Điểm đến: <%= tour.destination %></span>
        <span class="badge badge-secondary">Thời gian: <%= tour.duration %> ngày</span>
        <span class="badge badge-accent">Tối đa: <%= tour.max_slots %> người</span>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container tour-detail-layout">
      <!-- Left: Tour info & Reviews -->
      <div class="tour-detail-main">
        <% if (typeof reviewed !== 'undefined' && reviewed) { %>
        <div class="alert alert-success" style="margin-bottom:1.5rem">
          <strong>Cảm ơn bạn!</strong> Đánh giá của bạn về tour này đã được ghi nhận.
        </div>
        <% } %>

        <div class="tour-detail-img">
          <img src="<%= tour.image_url || '/css/placeholder.jpg' %>" alt="<%= tour.name %>" onerror="this.src='/css/placeholder.jpg'" />
        </div>
        <div class="card" style="margin-bottom: 2rem;">
          <h2>Mô Tả Tour</h2>
          <p class="tour-full-desc"><%= tour.description || 'Tour du lịch tuyệt vời tại ' + tour.destination %></p>
        </div>

        <!-- Reviews Section -->
        <div class="card" id="reviewsSection">
          <div class="reviews-header-row">
            <div>
              <h2>Đánh Giá Từ Khách Hàng (<%= reviews ? reviews.length : 0 %>)</h2>
              <p class="text-muted" style="font-size:0.9rem">Nhận xét thực tế từ du khách đã trải nghiệm tour</p>
            </div>
            <% 
              let avgScore = 5.0;
              if (reviews && reviews.length > 0) {
                const total = reviews.reduce((sum, r) => sum + r.rating, 0);
                avgScore = (total / reviews.length).toFixed(1);
              }
            %>
            <div class="tour-avg-badge">
              <span class="avg-num"><%= avgScore %> / 5.0</span>
              <span class="avg-label">Độ hài lòng</span>
            </div>
          </div>

          <!-- Existing Reviews Feed -->
          <div class="tour-reviews-feed" style="margin-top: 1.5rem;">
            <% if (!reviews || reviews.length === 0) { %>
              <p class="text-muted" style="padding: 1rem 0;">Chưa có đánh giá nào cho tour này. Hãy là người đầu tiên để lại cảm nhận!</p>
            <% } else { %>
              <% reviews.forEach(r => { %>
              <div class="tour-review-box">
                <div class="tr-top">
                  <div>
                    <strong><%= r.customer_name %></strong>
                    <span class="verified-pill" style="margin-left: 6px;">Đã đi tour</span>
                  </div>
                  <div class="tr-score"><%= r.rating %>.0 / 5.0</div>
                </div>
                <div class="tr-date text-muted"><%= new Date(r.travel_date || r.created_at).toLocaleDateString('vi-VN') %></div>
                <p class="tr-comment"><%= r.comment %></p>
              </div>
              <% }) %>
            <% } %>
          </div>

          <!-- Add Review Form -->
          <div class="tour-review-form-wrap" style="margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
            <h3>Gửi Đánh Giá Của Bạn Cho Tour Này</h3>
            <form action="/reviews" method="POST" style="margin-top: 1rem;">
              <input type="hidden" name="tour_id" value="<%= tour.id %>" />
              <input type="hidden" name="redirect_tour" value="1" />
              
              <div class="form-row">
                <div class="form-group">
                  <label for="rev_name">Họ và tên <span class="required">*</span></label>
                  <input type="text" id="rev_name" name="customer_name" required placeholder="Họ và tên của bạn" class="form-input" />
                </div>
                <div class="form-group">
                  <label for="rev_rating">Đánh giá <span class="required">*</span></label>
                  <select id="rev_rating" name="rating" required class="form-select">
                    <option value="5" selected>★★★★★</option>
                    <option value="4">★★★★☆</option>
                    <option value="3">★★★☆☆</option>
                    <option value="2">★★☆☆☆</option>
                    <option value="1">★☆☆☆☆</option>
                  </select>
                </div>
              </div>

              <div class="form-group" style="margin-bottom:1rem;">
                <label for="rev_comment">Nhận xét chi tiết <span class="required">*</span></label>
                <textarea id="rev_comment" name="comment" required rows="3" placeholder="Chia sẻ về chuyến đi, hướng dẫn viên, nơi ở, dịch vụ..." class="form-textarea"></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-sm">Gửi Nhận Xét</button>
            </form>
          </div>
        </div>
      </div>

      <!-- Right: Booking sidebar -->
      <div class="tour-detail-sidebar">
        <div class="card price-card">
          <div class="price-big"><%= parseInt(tour.price).toLocaleString('vi-VN') %> ₫</div>
          <div class="price-per">/ người</div>

          <h3 style="margin-top:1.5rem">Lịch Khởi Hành</h3>
          <% if (schedules.length === 0) { %>
            <div class="alert alert-warning">Hiện chưa có lịch khởi hành. Vui lòng liên hệ để biết thêm.</div>
          <% } else { %>
          <div class="schedule-list">
            <% schedules.forEach(sch => { %>
            <div class="schedule-item">
              <div class="schedule-date">
                Khởi hành: <%= new Date(sch.departure_date).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              </div>
              <div class="schedule-slots"><%= sch.available_slots %> chỗ còn</div>
              <a href="/bookings/new?schedule_id=<%= sch.id %>" class="btn btn-primary btn-sm" style="width:100%;text-align:center">Đặt Ngay</a>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>

        <div class="card">
          <h3>Dịch Vụ Bao Gồm</h3>
          <ul class="include-list">
            <li>Xe đưa đón theo lịch trình</li>
            <li>Khách sạn tiêu chuẩn</li>
            <li>Hướng dẫn viên tiếng Việt</li>
            <li>Bảo hiểm du lịch</li>
            <li>Ăn sáng mỗi ngày</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
